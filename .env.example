NODE_ENV=development
PORT=5000

DATABASE_URL=postgres://username:password@localhost:5432/rovia_dev
DATABASE_URL_TEST=postgres://username:password@localhost:5432/rovia_test

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Rovia <noreply@rovia.app>

# Backblaze B2 Object Storage (S3-Compatible)
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_ACCESS_KEY_ID=your_backblaze_key_id_here
STORAGE_SECRET_ACCESS_KEY=your_backblaze_application_key_here
STORAGE_BUCKET_NAME=rovia-documents
STORAGE_REGION=us-west-004

GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODEL=gemini-3.6-flash

API_BASE_URL=https://<your-real-api-host>/api/v1